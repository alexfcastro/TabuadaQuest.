+
+/* Competitive module - independent from progression */
+const COMPETITIVE_KEY='tabuadaQuestCompetitiveV1';
+let compState={name:'',questions:[],index:0,score:0,correct:0,wrong:0,totalMs:0,startedAt:0,timer:null,locked:false};
+function loadCompetitiveRanking(){try{return JSON.parse(localStorage.getItem(COMPETITIVE_KEY)||'[]')}catch(e){return []}}
+function saveCompetitiveRanking(r){localStorage.setItem(COMPETITIVE_KEY,JSON.stringify(r))}
+function formatCompetitiveDateTime(ts){
+  if(!ts)return 'data não registrada';
+  try{
+    return new Date(ts).toLocaleString('pt-BR',{
+      day:'2-digit',month:'2-digit',year:'numeric',
+      hour:'2-digit',minute:'2-digit'
+    });
+  }catch(e){return 'data não registrada'}
+}
+function openCompetitive(){navigate('competitive');document.getElementById('compStart').classList.remove('hidden');document.getElementById('compGame').classList.add('hidden');document.getElementById('compResult').classList.add('hidden');renderCompetitiveRanking()}
+function competitiveQuestions(){const q=[];for(let table=1;table<=10;table++){const mult=1+Math.floor(Math.random()*10);q.push({table,mult,answer:table*mult})}return shuffle(q)}
+function startCompetition(){
+  const input=document.getElementById('compName');const name=(input.value||'').trim();
+  if(name.length<2){showToast('Digite um nome com pelo menos 2 letras.');return}
+  compState={name,questions:competitiveQuestions(),index:0,score:0,correct:0,wrong:0,totalMs:0,startedAt:0,timer:null,locked:false};
+  document.getElementById('compStart').classList.add('hidden');document.getElementById('compResult').classList.add('hidden');document.getElementById('compGame').classList.remove('hidden');
+  try{primeAudio()}catch(e){};showCompetitiveQuestion();
+}
+function showCompetitiveQuestion(){
+  clearInterval(compState.timer);compState.locked=false;
+  const q=compState.questions[compState.index];
+  document.getElementById('compProgress').textContent=`Pergunta ${compState.index+1}/10`;
+  document.getElementById('compScore').textContent=compState.score;
+  document.getElementById('compQuestion').textContent=`${q.table} × ${q.mult} = ?`;
+  document.getElementById('compFeedback').textContent='';
+  const grid=document.getElementById('compAnswers');grid.innerHTML='';
+  makeOptions(q.answer).forEach(v=>{const b=document.createElement('button');b.className='comp-answer';b.textContent=v;b.onclick=()=>answerCompetition(v);grid.appendChild(b)});
+  compState.startedAt=performance.now();
+  const bar=document.getElementById('compTimerBar'),txt=document.getElementById('compTimeText');
+  bar.style.width='100%';txt.textContent='10,0 s';
+  compState.timer=setInterval(()=>{const elapsed=performance.now()-compState.startedAt;const left=Math.max(0,10000-elapsed);bar.style.width=(left/100)+'%';txt.textContent=(left/1000).toFixed(1).replace('.',',')+' s';if(left<=0){clearInterval(compState.timer);answerCompetition(null,true)}},80);
+}
+function answerCompetition(value,timeout=false){
+  if(compState.locked)return;compState.locked=true;clearInterval(compState.timer);
+  const q=compState.questions[compState.index];const elapsed=Math.min(10000,performance.now()-compState.startedAt);compState.totalMs+=elapsed;
+  const ok=!timeout && Number(value)===q.answer;const fb=document.getElementById('compFeedback');
+  if(ok){const speed=Math.max(0,Math.round((10000-elapsed)/50));const earned=100+speed;compState.score+=earned;compState.correct++;fb.textContent=`✅ Certo! +${earned} pontos`;try{playSoundEffect('correct')}catch(e){}}
+  else{compState.score-=150;compState.wrong++;fb.textContent=timeout?'⏱️ Tempo esgotado! -150 pontos':`❌ Resposta correta: ${q.answer}. -150 pontos`;try{playSoundEffect('wrong')}catch(e){}}
+  document.getElementById('compScore').textContent=compState.score;
+  setTimeout(()=>{compState.index++;if(compState.index>=10)finishCompetition();else showCompetitiveQuestion()},650);
+}
+function finishCompetition(){
+  clearInterval(compState.timer);document.getElementById('compGame').classList.add('hidden');document.getElementById('compResult').classList.remove('hidden');
+  const avg=compState.totalMs/10;
+  let ranking=loadCompetitiveRanking();
+  const key=compState.name.toLocaleLowerCase('pt-BR');
+  const old=ranking.find(x=>x.key===key);
+  const now=Date.now();
+  const entry={
+    key,
+    name:compState.name,
+    score:compState.score,
+    correct:compState.correct,
+    wrong:compState.wrong,
+    totalMs:Math.round(compState.totalMs),
+    bestAt:now,
+    updatedAt:now,
+    attempts:(old?.attempts||0)+1
+  };
+
+  let isNewBest=!old;
+  if(old){
+    // Compatibilidade com rankings criados antes da V25.
+    if(!old.bestAt && old.updatedAt)old.bestAt=old.updatedAt;
+    const better=
+      entry.score>old.score ||
+      (entry.score===old.score && entry.correct>old.correct) ||
+      (entry.score===old.score && entry.correct===old.correct && entry.totalMs<old.totalMs);
+
+    if(better){
+      Object.assign(old,entry);
+      isNewBest=true;
+    }else{
+      old.attempts=entry.attempts;
+      isNewBest=false;
+    }
+  }else{
+    ranking.push(entry);
+  }
+
+  ranking.sort((a,b)=>b.score-a.score||b.correct-a.correct||a.totalMs-b.totalMs);
+  ranking=ranking.slice(0,50);
+  saveCompetitiveRanking(ranking);
+
+  const saved=ranking.find(x=>x.key===key);
+  const pos=ranking.findIndex(x=>x.key===key)+1;
+  document.getElementById('compFinalScore').textContent=`${compState.score} pts`;
+  document.getElementById('compPlace').textContent=pos?`Posição no ranking: ${pos}º`:'Resultado registrado';
+  document.getElementById('compSummary').textContent=`${compState.correct} acertos • ${compState.wrong} erros • média de ${(avg/1000).toFixed(2).replace('.',',')} s por pergunta`;
+
+  const bestWhen=document.getElementById('compBestWhen');
+  if(bestWhen && saved){
+    bestWhen.textContent=isNewBest
+      ? `🏅 Novo melhor resultado registrado em ${formatCompetitiveDateTime(saved.bestAt)}`
+      : `🕒 Seu melhor resultado continua sendo o de ${formatCompetitiveDateTime(saved.bestAt)}`;
+  }
+
+  try{playSoundEffect('complete')}catch(e){}
+  renderCompetitiveRanking();
+}
+function renderCompetitiveRanking(){
+  const box=document.getElementById('competitiveRanking');
+  if(!box)return;
+  const r=loadCompetitiveRanking();
+  box.innerHTML='';
+  if(!r.length){
+    box.innerHTML='<div class="comp-muted" style="text-align:center;padding:18px">Ainda não há resultados. Seja o primeiro!</div>';
+    return;
+  }
+
+  let changed=false;
+  r.forEach(x=>{
+    if(!x.bestAt && x.updatedAt){x.bestAt=x.updatedAt;changed=true}
+  });
+  if(changed)saveCompetitiveRanking(r);
+
+  r.forEach((x,i)=>{
+    const d=document.createElement('div');
+    d.className='rank-row';
+    const medal=i===0?'🥇':i===1?'🥈':i===2?'🥉':`${i+1}º`;
+    const when=formatCompetitiveDateTime(x.bestAt||x.updatedAt);
+    d.innerHTML=`<div class="rank-pos">${medal}</div><div><div class="rank-name"></div><div class="rank-meta">${x.correct}/10 acertos • ${(x.totalMs/10000).toFixed(1).replace('.',',')} s total • ${x.attempts||1} tentativa(s)<br>📅 Melhor resultado: ${when}</div></div><div class="rank-score">${x.score} pts</div>`;
+    d.querySelector('.rank-name').textContent=x.name;
+    box.appendChild(d);
+  });
+}
+function prepareCompetitionReplay(){document.getElementById('compResult').classList.add('hidden');document.getElementById('compStart').classList.remove('hidden');document.getElementById('compName').value=compState.name||'';document.getElementById('compName').focus()}
+
 </script>
